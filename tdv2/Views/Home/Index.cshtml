@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Transformación Digital UACJ</title>
<link rel="preload" href="/fonts/noto-sans/NotoSans-Regular.ttf" as="font" type="font/ttf" crossorigin>
<link rel="stylesheet" href="/css/institutional.css">
<link rel="stylesheet" href="/css/public-quiz.css">
<script src="/js/public-navigation.js" defer></script>
<script src="/js/public-quiz.js" defer></script>
<style>
  :root{
    --azul:var(--uacj-blue);
    --gris:var(--uacj-gray);
    --blanco:var(--uacj-white);
    /* Complementario sólo para controles resaltados y preguntas abiertas. */
    --resaltado:var(--uacj-soft);
    --alto-cabecera:67px;
    --acento:var(--azul);
    --gris-2:var(--gris);
    --tinta:var(--azul);
    --tinta-2:var(--azul);
    --radio:14px;
    --sombra:0 1px 2px rgb(from var(--azul) r g b / .06), 0 12px 32px rgb(from var(--azul) r g b / .06);
    --ancho:1180px;
  }

  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    min-height:100dvh;display:flex;flex-direction:column;
    font-family:var(--font-interface);
    color:var(--tinta);
    background:var(--blanco);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
  .public-content{flex:1 0 auto;width:100%}
  body>.topbar,body>footer{flex-shrink:0}
  a,a:visited,a:hover,a:focus{text-decoration:none}
  h1,h2,h3,h4{font-family:var(--font-interface);line-height:1.12;letter-spacing:-.01em}

  .eyebrow{
    font-family:var(--font-interface);
    font-size:.72rem;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:var(--acento);
    display:inline-flex;
    align-items:center;
    gap:.55rem;
  }
  .eyebrow::before{
    content:"";
    width:22px;height:1px;
    background:var(--acento);
    display:inline-block;
  }

  .wrap{max-width:var(--ancho);margin:0 auto;padding:0 24px}

  .btn{
    display:inline-flex;align-items:center;gap:.5rem;
    font-family:var(--font-interface);
    font-weight:600;font-size:.94rem;
    padding:.72rem 1.25rem;
    border-radius:10px;
    border:1px solid transparent;
    cursor:pointer;
    transition:background .2s ease, color .2s ease, border-color .2s ease;
  }
  .btn-primary{background:var(--blanco);color:var(--azul)}
  .btn-primary:hover{background:var(--resaltado)}
  .btn-outline{background:transparent;color:var(--blanco);border-color:rgb(from var(--blanco) r g b / .4)}
  .btn-outline:hover{border-color:var(--blanco);background:var(--blanco);color:var(--azul)}
  .btn-dark{background:var(--azul);color:var(--blanco)}
  .btn-dark:hover{background:var(--resaltado);color:var(--azul);border-color:var(--azul)}
  .btn:active{box-shadow:inset 0 0 0 1px currentColor}
  .registration-cta{max-width:100%;text-align:left}
  .registration-cta>span:first-child{min-width:0}
  .registration-cta .ar{flex-shrink:0}

  /* ---------- Topbar ---------- */
  .topbar{
    position:sticky;top:0;z-index:50;
    background:var(--blanco);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--gris-2);
  }
  .topbar .wrap{display:flex;align-items:center;justify-content:space-between;height:66px}
  .brand{display:flex;align-items:center;gap:.7rem}
  .brand .mark{
    width:38px;height:38px;border-radius:9px;
    background:linear-gradient(135deg,var(--azul),var(--azul));
    display:grid;place-items:center;flex:0 0 auto;
  }
  .brand .name{line-height:1.15}
  .brand .name b{font-family:var(--font-interface);font-weight:700;font-size:.98rem;display:block;letter-spacing:-.02em}
  .brand .name span{font-family:var(--font-interface);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--tinta-2)}
  .nav{display:flex;align-items:center;gap:1.6rem}
  .nav a{font-size:.9rem;color:var(--tinta-2);font-weight:500;transition:color .18s}
  .nav a:hover,.nav a:focus-visible{color:var(--azul);background:var(--resaltado)}
  .topbar .btn{padding:.55rem 1rem;font-size:.86rem}
  .session-actions button.btn{color:var(--azul);border-color:var(--azul)}
  .session-actions button.btn:hover{background:var(--resaltado)}

  .session-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}
  .session-actions form{margin:0}
  @@media(max-width:1200px){.nav{display:none}}
  @@media(max-width:640px){
    .topbar .wrap{height:auto;min-height:66px;flex-wrap:wrap;gap:8px;padding-top:10px;padding-bottom:10px}
    .session-actions{flex-wrap:wrap}
  }

  /* Logo Transformación Digital en la barra superior */
  .topbar .brand-logo{
    display:block;
    width:auto;
    height:48px;
    max-width:260px;
    object-fit:contain;
  }

  /* Los acentos claros conservan contraste sobre las superficies oscuras existentes. */
  .hero, .dark-card, .m-center, .panel.contact, .net { --acento:var(--blanco); }

  /* ---------- Hero ---------- */
  .hero{
    position:relative;overflow:hidden;
    --hero-overlay:linear-gradient(105deg, rgb(from var(--azul) r g b / .80) 0%, rgb(from var(--azul) r g b / .74) 45%, rgb(from var(--azul) r g b / .68) 100%);
    background:
      var(--hero-overlay),
      url('/images/portal/img_9885-1920.jpg') center 55%/cover no-repeat var(--azul);
    color:var(--blanco);
  }
  .hero .wrap{
    display:block;
    padding-top:96px;padding-bottom:96px;
  }
  .hero .hero-text{max-width:640px}
  .hero h1{font-size:clamp(1.5rem,3.8vw,2.375rem);font-weight:600;margin:0 0 1rem}
  .hero h1 em{font-style:normal;color:var(--acento)}
  .hero .lead{font-size:1.08rem;color:var(--blanco);max-width:46ch;margin-bottom:1.9rem}
  .hero-cta{display:flex;flex-wrap:wrap;gap:.7rem}

  .hero .identidad-institucional {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 36px;
  }

  .hero .uacj-logo {
    display: block;
    width: 560px;
    max-width: 100%;
    height: auto;
    /* El PNG original contiene 96 px transparentes a la izquierda de sus 2934 px. */
    transform: translateX(-3.272%);
  }

  .hero .direccion-general {
    margin: 0;
    line-height: 1.25;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--blanco);
  }

  /* node network signature */
  .net{position:relative;width:100%;aspect-ratio:1/.92}
  .net svg{width:100%;height:100%;display:block;overflow:visible}
  .net .edge{stroke:rgb(from var(--blanco) r g b / .18);stroke-width:1.2}
  .net .edge.live{stroke:var(--acento);stroke-width:1.6;stroke-dasharray:5 7;animation:flow 3.4s linear infinite}
  @@keyframes flow{to{stroke-dashoffset:-24}}
  .net .node circle{fill:var(--azul);stroke:rgb(from var(--blanco) r g b / .35);stroke-width:1.4}
  .net .node.hub circle{fill:var(--acento);stroke:rgb(from var(--blanco) r g b / .6)}
  .net .node.accent circle{fill:var(--azul);stroke:var(--acento)}
  .net .node text{font-family:var(--font-interface);font-size:9.5px;fill:var(--blanco);letter-spacing:.02em}
  .net .pulse{fill:none;stroke:var(--acento);opacity:0;transform-origin:center;animation:pulse 3.4s ease-out infinite}
  @@keyframes pulse{0%{opacity:.5;r:16}70%{opacity:0;r:46}100%{opacity:0}}

  /* thin metric strip under hero */
  .strip{border-top:1px solid rgb(from var(--blanco) r g b / .12);background:rgb(from var(--azul) r g b / .14)}
  .strip .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;padding:0}
  .strip .cell{padding:20px 24px}
  .strip .cell b{font-family:var(--font-interface);font-weight:600;font-size:.98rem;color:var(--blanco);display:block}
  .strip .cell span{font-family:var(--font-interface);font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--blanco)}

  /* ---------- Layout (main + aside) ---------- */
  .layout{display:grid;grid-template-columns:1fr 320px;gap:52px;padding:72px 0}
  section[id],.panel[id]{scroll-margin-top:calc(var(--alto-cabecera) + 18px)}
  section.block{margin-bottom:64px}
  section.block:last-child{margin-bottom:0}
  .block > h2{font-size:clamp(1.6rem,2.6vw,2.05rem);font-weight:700;margin:.7rem 0 .5rem}
  .block .sub{color:var(--tinta-2);max-width:62ch;margin-bottom:1.6rem;font-size:1.03rem}
  .block p.body{color:var(--tinta);margin-bottom:1rem;max-width:64ch}

  /* Qué es — highlight */
  .highlight{
    border-left:3px solid var(--acento);
    background:var(--gris);
    padding:1.1rem 1.3rem;border-radius:0 10px 10px 0;
    margin-top:.6rem;font-size:1.05rem;color:var(--azul);
  }

  /* Modelo conceptual */
  .model{
    position:relative;
    background:linear-gradient(180deg,var(--blanco) 0%, rgb(from var(--gris) r g b / .18) 100%);
    border:1px solid var(--gris-2);
    border-radius:20px;padding:34px 30px;
  }
  .model-grid{
    display:grid;gap:16px;
    grid-template-columns:1fr 1.25fr 1fr;
    grid-template-areas:
      "dir dir dir"
      "oper center hab"
      "control center personas";
  }
  .m-card{
    background:var(--blanco);backdrop-filter:blur(4px);
    border:1px solid var(--gris);border-radius:12px;
    padding:18px 20px;text-align:center;
    box-shadow:0 2px 6px rgb(from var(--azul) r g b / .04);
  }
  .m-cat{
    font-family:var(--font-interface);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;
    color:var(--blanco);background:var(--azul);border:1px solid var(--azul);
    padding:.28rem .7rem;border-radius:999px;display:inline-block;margin-bottom:.6rem;
  }
  .m-card h3{font-family:var(--font-interface);font-size:1.12rem;font-weight:600;margin-bottom:.2rem}
  .m-card p{font-size:.86rem;color:var(--tinta-2)}
  .m-dir{grid-area:dir;justify-self:center;width:100%;max-width:340px}
  .m-oper{grid-area:oper}
  .m-hab{grid-area:hab}
  .m-control{grid-area:control}
  .m-personas{grid-area:personas}
  .m-center{
    grid-area:center;
    background:linear-gradient(150deg,var(--azul),var(--azul));
    color:var(--blanco);border:2px solid rgb(from var(--azul) r g b / .55);
    border-radius:16px;padding:26px;text-align:center;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    box-shadow:0 4px 12px rgb(from var(--azul) r g b / .12);
  }
  .m-center h3{font-family:var(--font-interface);font-weight:700;font-size:clamp(1.3rem,2.6vw,1.7rem);color:var(--blanco);line-height:1.08}
  .m-center span{font-family:var(--font-interface);font-size:.64rem;letter-spacing:.16em;text-transform:uppercase;color:var(--acento);margin-top:.6rem}
  .persp-bar{
    margin-top:16px;display:flex;flex-wrap:wrap;align-items:center;gap:.6rem 1.1rem;
    background:var(--blanco);backdrop-filter:blur(4px);
    border:1px solid var(--gris);border-left:4px solid var(--acento);
    border-radius:12px;padding:16px 22px;box-shadow:0 2px 6px rgb(from var(--azul) r g b / .04);
  }
  .persp-bar b{font-family:var(--font-interface);font-size:.7rem;letter-spacing:.15em;text-transform:uppercase;color:var(--acento)}
  .persp-bar span{font-size:1rem;color:var(--azul);font-weight:500}

  /* Ejes — tinted band + cards */
  .band{
    background:linear-gradient(180deg,var(--blanco) 0%, var(--gris) 100%);
    border:1px solid var(--gris-2);
    border-radius:20px;padding:38px 34px;
  }
  .cards{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:1.4rem}
  .card{
    background:var(--blanco);border:1px solid var(--gris-2);
    border-radius:var(--radio);padding:22px;
  }
  .ico{
    width:42px;height:42px;border-radius:10px;display:grid;place-items:center;
    background:var(--azul);color:var(--blanco);margin-bottom:.85rem;
  }
  .card h3{font-size:1.06rem;font-weight:600;margin-bottom:.4rem;font-family:var(--font-interface)}
  .card p{font-size:.92rem;color:var(--tinta-2)}

  /* Ruta — numbered timeline */
  .steps{margin-top:1.4rem;border-left:2px solid var(--azul);padding-left:0}
  .step{position:relative;padding:0 0 26px 44px}
  .step:last-child{padding-bottom:0}
  .step .num{
    position:absolute;left:-17px;top:0;
    width:32px;height:32px;border-radius:50%;
    background:var(--azul);color:var(--blanco);
    display:grid;place-items:center;
    font-family:var(--font-interface);font-size:.82rem;font-weight:500;
    border:3px solid var(--blanco);
  }
  .step h3{font-size:1.05rem;font-weight:600;margin-bottom:.15rem}
  .step p{font-size:.93rem;color:var(--tinta-2);max-width:60ch}

  /* Diagnóstico — dark card */
  .dark-card{
    background:linear-gradient(150deg,var(--azul) 0%,var(--azul) 100%);
    color:var(--blanco);border-radius:20px;padding:38px 34px;overflow:hidden;position:relative;
  }
  .dark-card h2{color:var(--blanco)}
  .dark-card .sub{color:var(--blanco)}
  .checks{display:grid;grid-template-columns:repeat(2,1fr);gap:.55rem 1.6rem;margin:1.3rem 0 1.7rem}
  .checks li{list-style:none;display:flex;gap:.6rem;font-size:.94rem;color:var(--blanco);align-items:flex-start}
  .checks svg{flex:0 0 auto;margin-top:3px;color:var(--acento)}

  /* Participa — register list */
  .reglist{columns:2;column-gap:2.4rem;margin:1.2rem 0 1.5rem}
  .reglist li{list-style:none;padding:.5rem 0 .5rem 1.5rem;position:relative;font-size:.94rem;break-inside:avoid;color:var(--tinta);border-bottom:1px solid var(--gris-2)}
  .reglist li::before{content:"→";position:absolute;left:0;color:var(--acento);font-family:var(--font-interface)}

  /* Beneficios */
  .benefits{display:grid;grid-template-columns:repeat(2,1fr);gap:.4rem 1.8rem;margin-top:1.3rem}
  .benefits li{list-style:none;display:flex;gap:.7rem;padding:.6rem 0;border-bottom:1px solid var(--gris-2);font-size:.96rem;color:var(--tinta);align-items:center}
  .benefits svg{flex:0 0 auto;color:var(--acento)}

  /* ---------- Aside ---------- */
  aside.side{position:sticky;top:84px;align-self:start;display:flex;flex-direction:column;gap:18px}
  .panel{border:1px solid var(--gris-2);border-radius:var(--radio);overflow:hidden;background:var(--blanco)}
  .panel h4{
    font-family:var(--font-interface);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;
    color:var(--tinta-2);padding:16px 18px 0;font-weight:500;
  }
  .panel ul{list-style:none;padding:10px 8px 12px}
  .panel.qa a{
    color:var(--tinta);
    transition:background .15s,color .15s;
  }
  .panel.qa a:hover,.panel.qa a:focus-visible{background:var(--resaltado);color:var(--azul)}
  .panel.qa a .ar{color:var(--tinta-2)}
  .panel.contact{background:linear-gradient(160deg,var(--azul),var(--azul));border:none;color:var(--blanco);padding:20px}
  .panel.contact h4{color:var(--blanco);padding:0 0 12px}
  .contact-info{display:flex;flex-direction:column;gap:8px}
  .contact-info p{margin:0}
  .contact-area{font-size:.9rem;font-weight:600;line-height:1.4;color:var(--blanco)}
  .contact-email{display:inline-flex;width:max-content;max-width:100%;font-size:.88rem;font-weight:600;color:var(--acento);overflow-wrap:anywhere;transition:background .15s ease,color .15s ease}
  .contact-email:hover,.contact-email:focus-visible{background:var(--resaltado);color:var(--azul)}
  .contact-meta{font-size:.84rem;line-height:1.45;color:var(--blanco)}
  .doclist a{display:flex;gap:.6rem;align-items:center;padding:.55rem .7rem;border-radius:8px;font-size:.88rem;color:var(--tinta);transition:background .15s}
  .doclist a:hover,.doclist a:focus-visible{background:var(--resaltado);color:var(--azul)}
  .doclist svg{color:var(--azul);flex:0 0 auto}

  /* ---------- Footer ---------- */
  .public-footer{margin-top:20px}
  @@media(max-width:960px){.hero{background-position:center,40% 55%}}
  @@media(max-width:640px){.hero{background-image:var(--hero-overlay),image-set(url('/images/portal/img_9885-960.jpg') 1x,url('/images/portal/img_9885-1920.jpg') 2x);background-position:center,32% center}}
  .diagnosis-actions{display:grid;gap:22px;margin-top:24px;justify-items:start}
  .diagnosis-game{border-top:1px solid #ffffff40;padding-top:18px;width:100%;display:flex;gap:12px 20px;align-items:center;flex-wrap:wrap}
  .diagnosis-game-copy{flex:1 1 280px;min-width:0}
  .diagnosis-game h3{font-size:1.05rem;line-height:1.4;margin:0}
  .diagnosis-game .quiz-launch{margin-top:0}
  .diagnosis-actions .btn{text-align:center;white-space:normal;max-width:100%}
  @@media(max-width:700px){.diagnosis-game{align-items:flex-start;flex-direction:column}.diagnosis-game-copy{flex:initial}}

  /* ---------- Responsive ---------- */
  @@media(max-width:1120px){
    .layout{grid-template-columns:1fr;gap:40px}
    aside.side{position:static;order:2;flex-direction:column}
  }
  @@media(max-width:960px){
    .hero .wrap{grid-template-columns:1fr;gap:36px;padding-top:48px;padding-bottom:48px}
    .net{max-width:440px;margin:0 auto}
    .strip .wrap{grid-template-columns:repeat(2,1fr)}
  }
  @@media(max-width:640px){
    .nav{display:none}
    .topbar .brand-logo{height:40px;max-width:210px}
    .cards,.checks,.benefits,.reglist{grid-template-columns:1fr;columns:1}
    .reglist{columns:1}
    .model-grid{
      grid-template-columns:1fr;
      grid-template-areas:"center" "dir" "oper" "hab" "control" "personas";
    }
    .m-dir{max-width:none}
  }
  @@media(prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important;scroll-behavior:auto!important}
  }
  :focus-visible{outline:3px solid var(--acento);outline-offset:2px;border-radius:4px}
  /* Hero lema */
  .hero .lema{font-family:var(--font-interface);font-weight:600;font-size:clamp(1.15rem,2.2vw,1.5rem);color:var(--blanco);line-height:1.25;margin:.2rem 0 1rem;max-width:34ch}

  /* Preguntas frecuentes */
  .faq-section{padding:60px 0 8px}
  .faq-section .eyebrow{margin-bottom:.5rem}
  .faq-section h2{font-size:clamp(1.6rem,2.6vw,2.05rem);font-weight:700;margin:.4rem 0 1.4rem}
  .faq{max-width:860px}
  .faq details{border:1px solid var(--gris-2);border-radius:12px;background:var(--blanco);margin-bottom:10px;overflow:hidden}
  .faq summary{list-style:none;cursor:pointer;padding:16px 20px;font-family:var(--font-interface);font-weight:600;font-size:1rem;display:flex;justify-content:space-between;align-items:center;gap:1rem}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary:hover{text-decoration:underline;text-underline-offset:.18em}
  .faq summary:focus-visible{outline-offset:-3px}
  .faq details[open] summary{background:var(--resaltado);color:var(--azul)}
  .faq summary .pm{flex:0 0 auto;width:22px;height:22px;position:relative}
  .faq summary .pm::before,.faq summary .pm::after{content:"";position:absolute;background:var(--azul);border-radius:2px}
  .faq summary .pm::before{top:10px;left:3px;right:3px;height:2px}
  .faq summary .pm::after{left:10px;top:3px;bottom:3px;width:2px;transition:opacity .2s}
  .faq details[open] summary .pm::after{opacity:0}
  .faq details p{padding:0 20px 18px;color:var(--tinta-2);font-size:.94rem;background:var(--blanco)}
  .model-img{margin:0}
  .model-img img{width:100%;height:auto;display:block;border-radius:14px;border:1px solid rgb(from var(--blanco) r g b / .6);box-shadow:0 12px 32px rgb(from var(--azul) r g b / .18)}
  .dgti-banner{width:100%;max-width:440px;height:auto;display:block;margin-bottom:22px}
  .dgti-foot{width:100%;max-width:300px;height:auto;display:block;margin-bottom:16px;opacity:.95}
  @@media(max-width:640px){.dgti-banner{max-width:320px;margin-bottom:16px}}
  .hero{position:relative;overflow:hidden}
  .hero .wrap{position:relative;z-index:1}
</style>
</head>
<body>
@if (ViewData["Error"] is string) {
  <div role="alert" class="wrap" style="padding:16px;margin-top:16px;background:var(--gris);color:var(--azul);border-radius:8px">
    @ViewData["Error"]
  </div>
}

<!-- ===== TOPBAR ===== -->
<header class="topbar">
  <div class="wrap">
    <a class="brand" href="#inicio" aria-label="Transformación Digital UACJ — inicio">
      <img
        src="/images/logos/TRANSFORMACION_DIGITAL_logo.svg"
        alt="Transformación Digital UACJ"
        class="brand-logo"
      >
    </a>
    <nav class="nav" aria-label="Secciones principales">
      <a href="#que-es">El proyecto</a>
      <a href="#modelo">Modelo</a>
      <a href="#ejes">Ejes</a>
      <a href="#ruta">Ruta</a>
      <a href="#diagnostico">Diagnóstico</a>
      <a href="#preguntas">Preguntas</a>
    </nav>
    @if (User.Identity?.IsAuthenticated == true) {
      <div class="session-actions">
      <a class="btn btn-dark" href="/connect?returnUrl=/accesos">Ir a mi espacio <span class="ar">→</span></a>
      <form method="POST" action="/logout">
        @Html.AntiForgeryToken()
        <button class="btn" type="submit">Cerrar sesión</button>
      </form>
      </div>
    } else {
      <a class="btn btn-dark" href="#participa">Participa <span class="ar">→</span></a>
    }
  </div>
</header>

<!-- ===== HERO ===== -->
<div class="public-content">
<section class="hero" id="inicio">
  <div class="wrap">
    <div class="hero-text">

      <div class="identidad-institucional">
        <img class="uacj-logo" src="/images/logos/firmaLogotipo-blancosinfondo-3.png"
             alt="Universidad Autónoma de Ciudad Juárez" width="2934" height="597">
        <p class="direccion-general">
          Dirección General de Tecnologías de la Información
        </p>
      </div>

      <h1>Transformación digital</h1>

      <p class="lema">
        Una universidad más ágil, integrada y centrada en las personas.
      </p>

      <p class="lead">
        Optimizamos procedimientos, gobernamos los datos y usamos la tecnología
        de forma estratégica, ética y segura para mejorar los servicios
        universitarios.
      </p>

    </div>
  </div>
</section>

<!-- ===== LAYOUT ===== -->
<div class="wrap">
  <div class="layout">

    <!-- ============ MAIN ============ -->
    <main>

      <!-- 1. Qué es -->
      <section class="block" id="que-es">
        <span class="eyebrow">El proyecto</span>
        <h2>¿Qué es la Transformación Digital UACJ?</h2>
        <p class="body">La Transformación Digital en la UACJ se conceptualiza como el cambio institucional para mejorar de forma integral la manera en que operamos: simplificar, estandarizar y optimizar procedimientos para que sean más ágiles, confiables y medibles, mediante el uso correcto de las herramientas tecnológicas.</p>
        <p class="body">Por ello, es un esfuerzo de toda la comunidad universitaria, porque los procedimientos están conectados y el resultado depende de cada eslabón; el punto de partida es el registro correcto, completo y oportuno de los datos.</p>
        <p class="highlight">La transformación digital es trabajar con datos confiables y tecnología institucional para generar eficiencia, transparencia y valor para la UACJ y su comunidad.</p>
      </section>

      <!-- Modelo conceptual -->
      <section class="block" id="modelo">
        <span class="eyebrow">Modelo conceptual</span>
        <h2>Cómo se articula la transformación</h2>
        <p class="sub">Cinco dimensiones giran en torno a un mismo centro. Cada una cumple un papel distinto y ninguna funciona aislada.</p>
        <div class="model">
          <div class="model-grid">
            <div class="m-card m-dir">
              <span class="m-cat">Dirección</span>
              <h3>Estrategia</h3>
              <p>Objetivos, visión y valor</p>
            </div>
            <div class="m-card m-oper">
              <span class="m-cat">Operación</span>
              <h3>Procedimientos</h3>
              <p>Automatización y mejoras</p>
            </div>
            <div class="m-center">
              <h3>Transformación<br>Digital</h3>
              <span>Centro del modelo</span>
            </div>
            <div class="m-card m-hab">
              <span class="m-cat">Habilitador</span>
              <h3>Tecnología</h3>
              <p>Infraestructura, bases de datos, IA</p>
            </div>
            <div class="m-card m-control">
              <span class="m-cat">Control</span>
              <h3>Gobernanza</h3>
              <p>Seguridad, datos, riesgos</p>
            </div>
            <div class="m-card m-personas">
              <span class="m-cat">Personas</span>
              <h3>Cultura</h3>
              <p>Aprendizaje y cambio organizacional</p>
            </div>
          </div>
          <div class="persp-bar">
            <b>Perspectiva</b>
            <span>La tecnología acelera; la estrategia dirige; la gobernanza sostiene.</span>
          </div>
        </div>
      </section>

      <!-- 2. Ejes -->
      <section class="block" id="ejes">
        <div class="band">
          <span class="eyebrow">Marco estratégico</span>
          <h2>Seis ejes que guían el trabajo</h2>
          <p class="sub">Cada eje agrupa un conjunto de acciones concretas. Juntos ordenan el esfuerzo institucional y evitan iniciativas aisladas.</p>
          <div class="cards">
            <div class="card">
              <div class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h10"/><circle cx="19" cy="18" r="2"/></svg></div>
              <h3>Procedimientos institucionales</h3>
              <p>Identificación, análisis, simplificación, estandarización y digitalización de procedimientos académicos y administrativos.</p>
            </div>
            <div class="card">
              <div class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/></svg></div>
              <h3>Gobernanza y calidad de datos</h3>
              <p>Responsables, criterios y mecanismos para garantizar datos confiables, disponibles, protegidos e interoperables.</p>
            </div>
            <div class="card">
              <div class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3 4 6v5c0 5 3.4 8.5 8 10 4.6-1.5 8-5 8-10V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg></div>
              <h3>Infraestructura y seguridad</h3>
              <p>Fortalecimiento de la infraestructura, la conectividad, la continuidad del servicio y la seguridad de la información.</p>
            </div>
            <div class="card">
              <div class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 6a3 3 0 0 1 0 5.6M21 20c0-2.4-1.4-4.5-3.5-5.5"/></svg></div>
              <h3>Personas y cultura digital</h3>
              <p>Alfabetización digital, participación, gestión del cambio y adopción responsable de nuevas tecnologías.</p>
            </div>
            <div class="card">
              <div class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/><circle cx="12" cy="12" r="3.5"/></svg></div>
              <h3>Innovación tecnológica</h3>
              <p>Plataformas, automatización de actividades, analítica de datos e incorporación responsable de inteligencia artificial.</p>
            </div>
            <div class="card">
              <div class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 22c5-2 8-6 8-11V5l-8-3-8 3v6c0 5 3 9 8 11Z" opacity=".25"/><path d="M12 12c-3 0-5-2-5-4 3 0 5 2 5 4Zm0 0c0-2 2-4 5-4 0 2-2 4-5 4Zm0 0v6"/></svg></div>
              <h3>Sustentabilidad tecnológica</h3>
              <p>Uso eficiente de recursos, reducción de duplicidades y evaluación del impacto económico, social y ambiental.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. Ruta -->
      <section class="block" id="ruta">
        <span class="eyebrow">Metodología</span>
        <h2>Ruta de Transformación Digital</h2>
        <p class="sub">Un camino de ocho etapas, del entendimiento inicial a la mejora continua. Cada etapa produce entregables que alimentan la siguiente.</p>
        <div class="steps">
          <div class="step"><span class="num">1</span><h3>Contextualización</h3><p>Comunicar la visión, los objetivos, el alcance y los beneficios del PITD</p></div>
          <div class="step"><span class="num">2</span><h3>Diagnóstico</h3><p>Evaluar la madurez digital de procedimientos, datos, infraestructura, seguridad, personas y sustentabilidad.</p></div>
          <div class="step"><span class="num">3</span><h3>Sensibilización</h3><p>Fortalecer cultura organizacional, cultura de datos y capacidades digitales</p></div>
          <div class="step"><span class="num">4</span><h3>Registro de procedimientos</h3><p>Documentar los procedimientos institucionales que desarrolla cada dependencia universitaria.</p></div>
          <div class="step"><span class="num">5</span><h3>Análisis y priorización</h3><p>Identificar problemas, duplicidades, riesgos, necesidades y oportunidades de mejora.</p></div>
          <div class="step"><span class="num">6</span><h3>Diseño de soluciones</h3><p>Definir mejoras, automatizaciones, integraciones y proyectos tecnológicos.</p></div>
          <div class="step"><span class="num">7</span><h3>Implementación</h3><p>Desarrollar, probar y poner en operación</p></div>
          <div class="step"><span class="num">8</span><h3>Seguimiento y mejora</h3><p>Evaluar resultados, indicadores, adopción e impacto institucional.</p></div>
        </div>
      </section>

      <!-- 4. Diagnóstico -->
      <section class="block" id="diagnostico">
        <div class="dark-card">
          <span class="eyebrow">Etapa 2</span>
          <h2>Diagnóstico de madurez digital</h2>
          <p class="sub">Una fotografía honesta de su área en estas 8 dimensiones:</p>
          <ul class="checks">
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Claridad y estandarización de los procedimientos</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Nivel de digitalización y automatización</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Calidad, disponibilidad e integración de datos</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Infraestructura, conectividad y seguridad</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Alfabetización digital del personal</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Experiencia de las personas usuarias</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Sustentabilidad y aprovechamiento tecnológico</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Uso de analítica de datos e inteligencia artificial</li>
          </ul>
          <div class="diagnosis-actions">
            <a class="btn btn-primary" href="/connect?returnUrl=/competencias-digitales">Responder encuesta de competencias digitales</a>
            <div class="diagnosis-game">
              <div class="diagnosis-game-copy"><h3>¿Qué tanto sabes de Microsoft 365?</h3></div>
              <button class="btn btn-outline quiz-launch" type="button" id="open-microsoft-quiz" aria-haspopup="dialog" aria-controls="microsoft-quiz-dialog">Jugar Ahora</button>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. Participa -->
      <section class="block" id="participa">
        <span class="eyebrow">Registro de procedimientos</span>
        <h2>Participa desde tu área</h2>
        <p class="sub">Para avanzar necesitamos conocer cómo funcionan hoy las dependencias. Cada área podrá registrar:</p>
        <ul class="reglist">
          <li>Nombre y objetivo del procedimiento</li>
          <li>Personas responsables y participantes</li>
          <li>Usuarios y áreas involucradas</li>
          <li>Actividades y flujo de trabajo</li>
          <li>Sistemas, plataformas y bases de datos</li>
          <li>Documentos y normatividad relacionados</li>
          <li>Problemas, tiempos de atención y duplicidades</li>
          <li>Datos generados, consultados o compartidos</li>
          <li>Riesgos y necesidades de seguridad</li>
          <li>Propuestas de mejora o automatización</li>
        </ul>
        <a class="btn btn-dark registration-cta" href="/connect?returnUrl=/inicio"><span>Registrar un procedimiento institucional</span> <span class="ar" aria-hidden="true">→</span></a>
      </section>

      <!-- Beneficios -->
      <section class="block" id="beneficios">
        <span class="eyebrow">Impacto</span>
        <h2>Beneficios para la comunidad</h2>
        <ul class="benefits">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Servicios más ágiles y accesibles</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Menos pasos y actividades repetitivas</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Información confiable y oportuna</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Mejor coordinación entre dependencias</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Mayor seguridad y protección de datos</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Decisiones sustentadas en evidencia</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Mejor experiencia para estudiantes y personal</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg>Uso responsable de la tecnología y la IA</li>
        </ul>
      </section>

    </main>

    <!-- ============ ASIDE ============ -->
    <aside class="side">
      <div class="panel qa" id="plan">
        <h4>Accesos rápidos</h4>
        <ul>
          <li><a href="#plan">Plan Institucional <span class="ar">→</span></a></li>
          <li><a href="#diagnostico">Diagnóstico de madurez <span class="ar">→</span></a></li>
          <li><a href="#participa">Registro de procedimientos <span class="ar">→</span></a></li>
          <li><a href="#docs">Documentos y lineamientos <span class="ar">→</span></a></li>
          <li><a href="#preguntas">Preguntas frecuentes <span class="ar">→</span></a></li>
        </ul>
      </div>

      <div class="panel contact">
        <h4>Contacto</h4>

        <div class="contact-info">
          <p class="contact-area">Dirección General de Tecnologías de la Información</p>
          <p class="contact-area">Subdirección de Inteligencia de Datos</p>
          <a class="contact-email" href="mailto:td.pi@@uacj.mx">td.pi@@uacj.mx</a>
          <p class="contact-meta">Extensiones telefónicas: 4374, 4274, 4174</p>
          <p class="contact-meta">Lunes a viernes, 8:00 a 15:00 h</p>
        </div>
      </div>

      <div class="panel doclist" id="docs">
        <h4>Documentos relacionados</h4>
        <ul>
          <li><a href="/documentos/PITD_2026_2030_Marco_General_UACJ.pdf" target="_blank" rel="noopener"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 2h8l4 4v16H6Z"/><path d="M14 2v4h4"/></svg>Plan Institucional de Transformación Digital<span class="sr-only"> (PDF, abre en una pestaña nueva)</span></a></li>
          <li><a href="/documentos/Decalogo_Cultura_de_Datos_UACJ.pdf" target="_blank" rel="noopener"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 2h8l4 4v16H6Z"/><path d="M14 2v4h4"/></svg>Decálogo<span class="sr-only"> (PDF, abre en una pestaña nueva)</span></a></li>
          <li><a href="/documentos/Glosario_Transformacion_Digital_UACJ.pdf" target="_blank" rel="noopener"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 2h8l4 4v16H6Z"/><path d="M14 2v4h4"/></svg>Glosario<span class="sr-only"> (PDF, abre en una pestaña nueva)</span></a></li>
        </ul>
      </div>
    </aside>

  </div>
</div>

<!-- ===== PREGUNTAS FRECUENTES ===== -->
<section class="faq-section" id="preguntas">
  <div class="wrap">
    <span class="eyebrow">Preguntas frecuentes</span>
    <h2>Resolvemos tus dudas</h2>
    <div class="faq">
      <details open><summary>¿Qué es la Transformación Digital UACJ?<span class="pm"></span></summary><p>Es un proceso institucional que integra personas, procedimientos, datos y tecnología para mejorar la forma en que la Universidad opera y presta sus servicios. No se trata solo de tecnología, sino de trabajar mejor con información confiable.</p></details>
      <details><summary>¿Cómo me beneficia?<span class="pm"></span></summary><p>Según tu rol, obtendrás procedimientos más simples, información más clara y oportuna, y servicios más accesibles. El objetivo es facilitar la vida universitaria de estudiantes, docentes y personal.</p></details>
      <details><summary>¿Qué papel juegan mis datos en la transformación?<span class="pm"></span></summary><p>El punto de partida es el registro correcto, completo y oportuno de los datos. Con información confiable es posible generar eficiencia, transparencia y decisiones basadas en evidencia.</p></details>
      <details><summary>¿Cómo se protege la información?<span class="pm"></span></summary><p>Mediante lineamientos de gobernanza de datos, medidas de ciberseguridad y avisos de privacidad. La protección y la continuidad de los servicios son parte central del proyecto.</p></details>
      <details><summary>¿Cómo puede participar mi área?<span class="pm"></span></summary><p>Cada dependencia puede registrar sus procedimientos institucionales y participar en el diagnóstico de madurez digital. La transformación es un esfuerzo de toda la comunidad, porque los procedimientos están conectados.</p></details>
      <details><summary>¿Con quién puedo ponerme en contacto?<span class="pm"></span></summary><p>Utiliza los datos de contacto disponibles en la columna lateral.</p></details>
    </div>
  </div>
</section>

