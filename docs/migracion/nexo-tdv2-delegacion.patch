diff --git a/app/Services/Postgres/conceder_acceso.sql b/app/Services/Postgres/conceder_acceso.sql
index f3732e6..c0e1a63 100644
--- a/app/Services/Postgres/conceder_acceso.sql
+++ b/app/Services/Postgres/conceder_acceso.sql
@@ -17,6 +17,12 @@ BEGIN
     IF NOT EXISTS (SELECT 1 FROM {{PREFIJO}}delegacion_roles WHERE rol_id = p_rol) THEN
         RAISE EXCEPTION 'NEXO: rol no autorizado para asignar';
     END IF;
+    -- Política de TDV2: nivel 3 sólo colaboración local; las demás aplicaciones conservan sus reglas.
+    IF EXISTS (SELECT 1 FROM public.aplicaciones WHERE id = {{APP_ID}} AND clave = 'tdv2')
+        AND NOT EXISTS (SELECT 1 FROM {{PREFIJO}}delegacion_roles WHERE rol_id = p_rol
+            AND (clave = 'colaborador_local' OR (v_nivel = 2 AND clave = 'colaborador_dependencias'))) THEN
+        RAISE EXCEPTION 'NEXO: rol no permitido para este nivel de responsabilidad';
+    END IF;
     {{RAMA}}
     SELECT MAX(email), MAX(nombre), MAX(usuario_empleado) INTO v_email, v_nombre, v_cuenta
         FROM personas WHERE email = LOWER(TRIM(p_email)) AND id_ur = p_ur;
